new file mode 100644
index 0000000..b09f189
--- /dev/null
+++ b/include/strata/core/batch_logit_trace.hpp
@@ -0,0 +1,66 @@
+#pragma once
+// Diagnostic capture only: full vocabulary, every batch row including draft candidates.
+// Files identify row/slot/position/input token. These do not alone identify a complete prefix.
+#include <cuda_runtime.h>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+#include <string>
+#include <vector>
+#if defined(_WIN32)
+#include <process.h>
+#else
+#include <unistd.h>
+#endif
+namespace strata::core {
+inline bool trace_batch_head(const float* logits,int64_t vocab,int S,const int* rows,
+    const int32_t* tokens,const int64_t* positions,const int32_t* selected,
+    int device,cudaStream_t stream,std::string& error) {
+    static const char* prefix=std::getenv("STRATA_DUMP_BATCH_LOGITS");
+    if (!prefix || !*prefix) return true;
+    static std::atomic<uint64_t> sequence{0},used{0};
+    static const uint64_t budget=[] {
+        const char* p=std::getenv("STRATA_BATCH_TRACE_MAX_BYTES");
+        if (!p || !*p) return uint64_t(2)<<30;
+        char* end=nullptr;const auto n=std::strtoull(p,&end,10);
+        return (!end || *end || *p=='-' || n==0) ? uint64_t(0) : uint64_t(n);
+    }();
+    if (vocab<=0 || S<=0 || S>8 || uint64_t(vocab)>SIZE_MAX/sizeof(float)/uint64_t(S)) {
+        error="batch trace: invalid head dimensions"; return false;
+    }
+    const uint64_t bytes=uint64_t(vocab)*uint64_t(S)*sizeof(float);
+    const auto consumed=used.fetch_add(bytes);
+    if (!budget || bytes>budget || consumed>budget-bytes) {
+        error="batch trace: capture budget exhausted; diagnostic incomplete";return false;
+    }
+    std::vector<float> host(size_t(vocab)*size_t(S));
+    if(cudaMemcpyAsync(host.data(),logits,(size_t)bytes,cudaMemcpyDeviceToHost,stream)!=cudaSuccess ||
+       cudaStreamSynchronize(stream)!=cudaSuccess) {error="batch trace: full head copy failed";return false;}
+    const uint64_t seq=sequence.fetch_add(1);
+#if defined(_WIN32)
+    const auto pid=_getpid();
+#else
+    const auto pid=getpid();
+#endif
+    const std::string stem=std::string(prefix)+"."+std::to_string(pid)+"."+std::to_string(seq);
+    std::FILE* f=std::fopen((stem+".f32").c_str(),"wb");
+    if(!f) {error="batch trace: cannot open payload";return false;}
+    const bool written=std::fwrite(host.data(),1,(size_t)bytes,f)==bytes;
+    const bool closed=std::fclose(f)==0;
+    if(!written || !closed) {error="batch trace: incomplete payload";return false;}
+    f=std::fopen((stem+".json").c_str(),"wb");
+    if(!f) {error="batch trace: cannot open metadata";return false;}
+    std::fprintf(f,"{\"sequence\":%llu,\"pid\":%d,\"device\":%d,\"vocab\":%lld,\"S\":%d,"
+        "\"bytes\":%llu,\"dtype\":\"native-float32\",\"kind\":\"batch-candidates-before-commit\",\"rows\":[",
+        (unsigned long long)seq,(int)pid,device,(long long)vocab,S,(unsigned long long)bytes);
+    for(int t=0;t<S;++t) std::fprintf(f,"%s{\"row\":%d,\"slot\":%d,\"position\":%lld,\"input_token\":%d,\"selected\":%d}",
+        t?",":"",t,rows[t],(long long)positions[t],tokens[t],selected[t]);
+    std::fputs("]}\n",f);
+    const bool metadata_ok=std::ferror(f)==0;
+    const bool metadata_closed=std::fclose(f)==0;
+    if(!metadata_ok || !metadata_closed) {error="batch trace: incomplete metadata";return false;}
+    return true;
+}
+}
diff --git a/include/strata/core/slot_trace.hpp b/include/strata/core/slot_trace.hpp
new file mode 100644
index 0000000..42379c2
--- /dev/null
+++ b/include/strata/core/slot_trace.hpp
@@ -0,0 +1,69 @@
+#pragma once
+// Diagnostic only. Trace-off does not call the clock, rusage, or stdio.
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#if defined(__linux__)
+#include <sys/resource.h>
+#endif
+namespace strata::core {
+inline bool slot_trace_enabled() {
+    static const bool enabled = [] { const char* p=std::getenv("STRATA_ADMISSION_TRACE");
+        return p && std::strcmp(p,"1")==0; }();
+    return enabled;
+}
+struct SlotTraceContext { uint64_t request=0; int slot=-1, stage=-1, layer=-1; };
+inline thread_local SlotTraceContext slot_trace_context;
+inline thread_local uint64_t slot_trace_sequence=0;
+class SlotTrace {
+    using Clock=std::chrono::steady_clock;
+    bool enabled_;
+    const char* phase_;
+    SlotTraceContext previous_;
+    Clock::time_point start_;
+    uint64_t bytes_;
+    long minor_=0, major_=0;
+public:
+    explicit SlotTrace(const char* phase, int slot=-2, int stage=-2, int layer=-2,
+                       uint64_t bytes=0, bool root=false)
+        : enabled_(slot_trace_enabled()), phase_(phase), bytes_(bytes) {
+        if (!enabled_) return;
+        previous_=slot_trace_context;
+        if (root) slot_trace_context.request=++slot_trace_sequence;
+        if (slot!=-2) slot_trace_context.slot=slot;
+        if (stage!=-2) slot_trace_context.stage=stage;
+        if (layer!=-2) slot_trace_context.layer=layer;
+        start_=Clock::now();
+#if defined(__linux__)
+        rusage u{}; if (getrusage(RUSAGE_THREAD,&u)==0) { minor_=u.ru_minflt; major_=u.ru_majflt; }
+#endif
+    }
+    SlotTrace(const SlotTrace&)=delete;
+    SlotTrace& operator=(const SlotTrace&)=delete;
+    ~SlotTrace() {
+        if (!enabled_) return;
+        const auto end=Clock::now();
+        long minor=0,major=0;
+#if defined(__linux__)
+        rusage u{}; if (getrusage(RUSAGE_THREAD,&u)==0) { minor=u.ru_minflt-minor_; major=u.ru_majflt-major_; }
+#endif
+        const auto c=slot_trace_context;
+        std::fprintf(stderr,"SLOT_TRACE {\"request\":%llu,\"slot\":%d,\"stage\":%d,\"layer\":%d,"
+          "\"phase\":\"%s\",\"start_us\":%lld,\"duration_us\":%lld,\"bytes\":%llu,"
+          "\"minor_faults\":%ld,\"major_faults\":%ld}\n",
+          (unsigned long long)c.request,c.slot,c.stage,c.layer,phase_,
+          (long long)std::chrono::duration_cast<std::chrono::microseconds>(start_.time_since_epoch()).count(),
+          (long long)std::chrono::duration_cast<std::chrono::microseconds>(end-start_).count(),
+          (unsigned long long)bytes_,minor,major);
+        slot_trace_context=previous_;
+    }
+};
+template<class T> class SlotTraceRelease {
+    T& object_; const char* phase_;
+public:
+    SlotTraceRelease(T& object,const char* phase):object_(object),phase_(phase) {}
+    ~SlotTraceRelease() { if(slot_trace_enabled()) { SlotTrace trace(phase_); object_=T{}; } }
+};
+} // namespace strata::core
